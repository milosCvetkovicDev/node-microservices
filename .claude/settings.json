{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(nx serve:*)",
      "Bash(nx test:*)",
      "Bash(nx build:*)",
      "Bash(nx lint:*)",
      "Bash(nx affected:*)",
      "Bash(nx e2e:*)",
      "Bash(nx generate:*)",
      "Bash(nx graph:*)",
      "Bash(nx run:*)",
      "Bash(nx run-many:*)",
      "Bash(npx nx:*)",
      "Bash(npx prettier:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(docker-compose up:*)",
      "Bash(docker-compose down:*)",
      "Bash(docker-compose logs:*)",
      "Bash(docker-compose build:*)",
      "Bash(docker-compose ps:*)",
      "Bash(docker build:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(make:*)"
    ]
  }
}
