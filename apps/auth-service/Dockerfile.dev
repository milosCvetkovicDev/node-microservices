# Development Dockerfile for auth-service
# Uses Nx serve with watch mode for hot reload

FROM node:20-alpine

WORKDIR /app

# Install dependencies only (source code will be mounted as volume)
COPY package*.json ./
COPY nx.json tsconfig.base.json ./

RUN npm ci --legacy-peer-deps

# Nx serve runs in watch mode by default
CMD ["npx", "nx", "serve", "auth-service"]
