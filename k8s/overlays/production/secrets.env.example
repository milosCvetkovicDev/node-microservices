# Production Secrets
# Copy this file to secrets.env and update with actual values
# DO NOT COMMIT secrets.env to version control!

# Database Configuration
DATABASE_URL=postgresql://prod_user:strong_password@postgres-prod.region.rds.amazonaws.com:5432/microservices_prod

# Redis Configuration
REDIS_PASSWORD=strong-redis-password
REDIS_URL=redis://:strong-redis-password@redis-cluster.cache.amazonaws.com:6379

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-production

# RabbitMQ Configuration
RABBITMQ_USER=admin
RABBITMQ_PASS=strong-rabbitmq-password
RABBITMQ_URL=amqp://admin:strong-rabbitmq-password@rabbitmq-prod:5672

# SMTP Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key

# External Service API Keys
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
STRIPE_API_KEY=sk_live_your-stripe-key
